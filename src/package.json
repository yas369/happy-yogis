{
  "name": "happy-yogis-site",
  "private": true,
  "description": "Build and checks for happyyogis.in. The site's HTML is generated; edit here, never the .html files.",
  "scripts": {
    "build": "python3 buildall.py",
    "check": "python3 validate.py",
    "serve": "python3 -m http.server 8123 --directory ..",
    "axe": "node checks/axeall.js",
    "mobile": "node checks/mobile.js",
    "align": "node checks/align.js",
    "perf": "node checks/lh2.js"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "lucide-static": "^1.38.0",
    "playwright": "^1.49.1",
    "tailwindcss": "^3.4.17"
  }
}
