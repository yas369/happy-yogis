{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.happyyogis.in"
        }
      ],
      "destination": "https://happyyogis.in/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.happyyogis.in"
        }
      ],
      "destination": "https://happyyogis.in/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ta",
      "destination": "/ta/index.html",
      "permanent": true
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
